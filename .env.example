# Cvent Data — credential template.
#
# Copy to .env (which is gitignored) and fill in real values, OR export the
# same variables in the real environment. The real environment ALWAYS wins
# over .env for any key it sets.
#
# The cvent package never writes these values into errors or logs — errors
# name the variable only (e.g. "CVENT_CLIENT_SECRET is not set").
#
#   chmod 600 .env

# Required: Cvent API client credentials (client_credentials OAuth2 flow).
CVENT_CLIENT_ID=
CVENT_CLIENT_SECRET=

# Optional: API base URL. Defaults to https://api-platform.cvent.com/ea.
# Point it at a local mock for offline testing (see tests/test_server.sh).
# CVENT_API_BASE=https://api-platform.cvent.com/ea

# Event codes/uuids, numbered from 1. `make dump` / cvent-dump pull every
# one when no event is given on the command line; the first is the app's
# default selection. (A single legacy CVENT_EVENT is used if none are set.)
CVENT_CODE_1=
# CVENT_CODE_2=
